@model ProductCardVM

<div class="product__item">

    <div class="product__banner">

        <a  class="product__images">

            <img src="@(Model.Images.FirstOrDefault() ?? "/images/no-image.png")"
                 class="product__img default"
                 alt="@Model.Name" />

            @if (Model.Images.Count > 1)
            {
                <img src="@Model.Images[1]"
                     class="product__img hover"
                     alt="@Model.Name" />
            }

        </a>

        <div class="product__actions">

            <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id"   class="action__btn"
               aria-label="Quick View">
                <i class="fi fi-rs-eye"></i>
            </a>

            <a href="#"
               class="action__btn add-wishlist"
               data-id="@Model.Id"
               aria-label="Wishlist">
                <i class="fi fi-rs-heart"></i>
            </a>

            

        </div>


    </div>

    <div class="product__content">

        <span class="product__category">
            @Model.Category
        </span>

        <a asp-controller="Home" asp-action="Details"  asp-route-id="@Model.Id">
            <h3 class="product__title">
                @Model.Name
            </h3>
        </a>


        <div class="product__price flex">

            @if (Model.DiscountPercentage > 0)
            {
                var oldPrice = Model.Price;
                var newPrice = Model.Price - (Model.Price * Model.DiscountPercentage / 100);

                <span class="new__price">
                    EGP @Model.Price.ToString("N2")
                </span>

            }
            else
            {
                <span class="new__price">
                    EGP @Model.Price.ToString("N2")
                </span>
            }

        </div>

        <a href="#"
           class="action__btn cart__btn add-cart"
           data-id="@Model.Id"
           aria-label="Add To Cart">
            <i class="fi fi-rs-shopping-bag-add"></i>
        </a>

    </div>

</div>

<script>


</script>

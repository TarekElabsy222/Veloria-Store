@model HomeVM
@{
    ViewData["Title"] = "Home Page";
}

<main class="main">
    <!--=============== HOME ===============-->
    <section class="home section--lg">
        <div class="home__container container grid">
            <div class="home__content">
                <span class="home__subtitle">Hot Promotions</span>
                <h1 class="home__title">
                    Fashion Trending <span>Great Collection</span>
                </h1>
                <p class="home__description">
                    Save more with coupons & up tp 20% off
                </p>
                <a asp-controller="Home" asp-action="Shop" class="btn">Shop Now</a>
            </div>
            <img src="~/img/home-img.png" class="home__img" alt="hats" />
        </div>
    </section>

    <!--=============== CATEGORIES ===============-->
    <section class="categories container section">
        <h3 class="section__title"><span>Popular</span> Categories</h3>
        <div class="categories__container swiper">
            <div class="swiper-wrapper">
                @foreach(var category in Model.Categories)
                {
                    <a asp-controller="Home"
                       asp-action="Shop"
                       asp-route-categoryId="@category.Id"
                       asp-route-page="1"
                       class="category__item swiper-slide">
                        <img src="@category.ImageUrl"  alt="@category.Name" class="category__img" />
                        <h3 class="category__title">@category.Name</h3>
                    </a>

                }

            </div>

            <div class="swiper-button-prev">
                <i class="fi fi-rs-angle-left"></i>
            </div>
            <div class="swiper-button-next">
                <i class="fi fi-rs-angle-right"></i>
            </div>
        </div>
    </section>

    <!--=============== PRODUCTS ===============-->
    <section class="products container section">
        <div class="tab__btns">
            <span class="tab__btn active-tab" data-target="#featured">Featured</span>
            <span class="tab__btn" data-target="#popular">Popular</span>
            <span class="tab__btn" data-target="#new-added">New Added</span>
        </div>

        <div class="tab__items">
            <div class="tab__item active-tab" content id="featured">
                <div class="products__container grid">
                   
                    @foreach(var product in Model.FeaturedProducts)
                    {
                        <partial name="_ProductCard" model="product" />
                    }


                </div>
            </div>
            <div class="tab__item" content id="popular">
                <div class="products__container grid">
                    
                    @foreach (var product in Model.PopularProducts)
                    {
                        <partial name="_ProductCard" model="product" />
                    }


                </div>
            </div>
            <div class="tab__item" content id="new-added">
                <div class="products__container grid">
                    @foreach (var product in Model.NewProducts)
                    {
                        <partial name="_ProductCard"  model="product" />
                    }
                </div>
            </div>
        </div>
    </section>

    <!--=============== DEALS ===============-->
    <section class="deals section">

        <div class="deals__container container grid">

            <!-- Left -->
            <div class="deals__item">

                <div class="deals__group">

                    <h3 class="deals__brand">
                        Coming Soon
                    </h3>

                    <span class="deals__category">
                        New Features Are On The Way
                    </span>

                </div>

                <h4 class="deals__title">
                    We're working on exciting new features, seasonal offers, and exclusive discounts to make your shopping experience even better.
                </h4>

                <div class="deals__price flex">

                    <span class="new__price">
                        Exclusive Offers
                    </span>

                    <span class="old__price">
                        Coming Soon
                    </span>

                </div>

                <div class="deals__group">

                    <p class="deals__countdown-text">
                        Stay connected and be among the first to enjoy our upcoming promotions.
                    </p>

                </div>

                <div class="deals__btn">

                    <a asp-controller="Home"
                       asp-action="Shop"
                       class="btn btn--md">

                        Explore Products

                    </a>

                </div>

            </div>

            <!-- Right -->
            <div class="deals__item">

                <div class="deals__group">

                    <h3 class="deals__brand">
                        About Veloria
                    </h3>

                    <span class="deals__category">
                        Designed For Modern Shopping
                    </span>

                </div>

                <h4 class="deals__title">
                    Veloria brings together quality products, a simple shopping experience, and reliable service to help you shop with confidence.
                </h4>

                <div class="deals__price flex">

                    <span class="new__price">
                        Quality Products
                    </span>

                    <span class="old__price">
                        Trusted Service
                    </span>

                </div>

                <div class="deals__group">

                    <p class="deals__countdown-text">
                        Thank you for choosing Veloria. We're committed to providing a smooth and enjoyable shopping experience every time you visit.
                    </p>

                </div>

                <div class="deals__btn">

                    <a href="https://wa.me/966573611664?text=Hello,%20I'm%20interested%20in%20your%20products."
                       target="_blank"
                       class="btn btn--md">

                        Contact Us

                    </a>

                </div>

            </div>

        </div>

    </section>

    <!--=============== NEW ARRIVALS ===============-->
    <section class="new__arrivals container section">
        <h3 class="section__title"><span>New</span> Arrivals</h3>
        <div class="new__container swiper">
                <div class="swiper-wrapper">

                    @foreach (var product in Model.NewProducts)
                    {
                        <div class="swiper-slide">
                            <partial name="_ProductCard" model="product" />
                        </div>
                    }
            </div>

            <div class="swiper-button-prev">
                <i class="fi fi-rs-angle-left"></i>
            </div>
            <div class="swiper-button-next">
                <i class="fi fi-rs-angle-right"></i>
            </div>
        </div>
    </section>

    <!--=============== SHOWCASE ===============-->
    <section class="showcase section">
        <div class="showcase__container container grid">
            <div class="showcase__wrapper">
                <h3 class="section__title">Hot Releases</h3>
                @foreach (var product in Model.TrendyProducts)
                {
                    <div class="showcase__item">
                        <a asp-controller="Home" asp-action="Index" class="showcase__img-box">
                            <img src="@product.Image" alt="@product.Image" class="showcase__img" />
                        </a>
                        <div class="showcase__content">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id">
                                <h4 class="showcase__title">
                                    @product.Name
                                </h4>
                            </a>
                            <div class="showcase__price flex">
                                <span class="new__price">EGP @product.Price.ToString("N2")</span>
                                @* <span class="old__price">$245.8</span> *@
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="showcase__wrapper">
                <h3 class="section__title">Deals & Outlet</h3>

                @foreach (var product in Model.DealsOutletProducts)
                {
                    <div class="showcase__item">

                    <a asp-controller="Home" asp-action="Index" class="showcase__img-box">
                        <img src="@product.Image" alt="@product.Image" class="showcase__img" />
                    </a>
                    <div class="showcase__content">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id">
                            <h4 class="showcase__title">
                                @product.Name
                            </h4>
                        </a>
                        <div class="showcase__price flex">
                                <span class="new__price">EGP @product.Price.ToString("N2")</span>
                        </div>
                        </div>
                    </div>
                }



            </div>
            <div class="showcase__wrapper">
                <h3 class="section__title">Top Selling</h3>                
                    @foreach(var product in Model.TopSellingProducts)
                    {
                    <div class="showcase__item">
                        <a asp-controller="Home" asp-action="Index" class="showcase__img-box">
                            <img src="@product.Image"  alt="@product.Image"  class="showcase__img" />
                    </a>
                    <div class="showcase__content">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id">
                            <h4 class="showcase__title">
                                @product.Name
                            </h4>
                        </a>
                        <div class="showcase__price flex">
                                <span class="new__price">EGP @product.Price.ToString("N2")</span>
                            @* <span class="old__price">$245.8</span> *@
                        </div>
                        </div>
                    </div>
                    }


                               
        </div>
            <div class="showcase__wrapper">
                <h3 class="section__title">Trendy</h3>

                @foreach (var product in Model.TrendyProducts)
                {
                    <div class="showcase__item">
                        <a asp asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="showcase__img-box">
                        <img src="@product.Image" alt="@product.Image" class="showcase__img" />
                    </a>
                    <div class="showcase__content">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id">
                            <h4 class="showcase__title">
                                @product.Name
                            </h4>
                        </a>
                        <div class="showcase__price flex">
                                <span class="new__price">EGP @product.Price.ToString("N2")</span>
                            @* <span class="old__price">$245.8</span> *@
                        </div>
                    </div>
                    </div>
                }


            </div>
        </div>
    </section>

    
</main>



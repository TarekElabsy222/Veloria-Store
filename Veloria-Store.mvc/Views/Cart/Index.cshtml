@using Veloria_Store.Application.ViewModels.CartItemViewModel
@model CartVM

<main class="main">
    <!--=============== BREADCRUMB ===============-->
    <section class="breadcrumb">
        <ul class="breadcrumb__list flex container">
            <li><a href="index.html" class="breadcrumb__link">Home</a></li>
            <li><span class="breadcrumb__link"></span>></li>
            <li><span class="breadcrumb__link">Shop</span></li>
            <li><span class="breadcrumb__link"></span>></li>
            <li><span class="breadcrumb__link">Cart</span></li>
        </ul>
    </section>

    <!--=============== CART ===============-->
    <section class="cart section--lg container">
        <div class="table__container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th>Rename</th>
                    </tr>
                </thead>
                
                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>

                                <img src="@item.Image"  class="table__img" />

                            </td>

                            <td>

                                <h3 class="table__title">

                                    @item.Name

                                </h3>

                            </td>

                            <td>

                                <span class="table__price">

                                    @item.Price.ToString("C")

                                </span>

                            </td>

                            <td>

                                <div class="cart-quantity">

                                    <button class="btn-cart-minus"
                                            data-id="@item.ProductId">

                                        -

                                    </button>

                                    <input value="@item.Quantity"
                                           readonly
                                           class="quantity" />

                                    <button class="btn-cart-plus"
                                            data-id="@item.ProductId">

                                        +

                                    </button>

                                </div>

                            </td>

                            <td>

                                <span class="subtotal">

                                    @item.Total.ToString("C")

                                </span>

                            </td>

                            <td>

                                <a href="#"
                                   class="remove-cart"
                                   data-id="@item.ProductId">

                                    <i class="fi fi-rs-trash table__trash"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>


            </table>
        </div>

        <div class="cart__actions">            
            <a asp-action="Shop" asp-controller="Home" class="btn flex btn__md">
                <i class="fi-rs-shopping-bag"></i> Continue Shopping
            </a>
        </div>

        <div class="divider">
            <i class="fi fi-rs-fingerprint"></i>
        </div>

        <div class="cart__group grid">           
            <div class="cart__total" style="border: none"></div>
            <div class="cart__total">
                <h3 class="section__title">Cart Totals</h3>
                <table class="cart__total-table">
                    <tr>
                        <td><span class="cart__total-title">Cart Subtotal</span></td>
                        <td><span id="cart-subtotal" class="cart__total-price">@Model.SubTotal.ToString("C")</span></td>
                    </tr>
                    <tr>
                        <td><span class="cart__total-title">Shipping</span></td>
                        <td><span class="cart__total-price">@Model.Shipping.ToString("C")</span></td>
                    </tr>
                    <tr>
                        <td><span class="cart__total-title">Total</span></td>
                        <td><span id="cart-total" class="cart__total-price">@Model.Total.ToString("C")</span></td>
                    </tr>
                </table>
                <a asp-controller="Checkout"
                   asp-action="Index"
                   class="btn flex btn--md">
                    <i class="fi fi-rs-box-alt"></i>
                    Proceed To Checkout
                </a>
            </div>
        </div>
    </section>

   
</main>





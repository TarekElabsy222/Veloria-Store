@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
}
    
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Veloria Admin - @ViewData["Title"]</title>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/admin/css/admin.css">
    <meta name="request-verification-token" content="@antiforgeryTokens.RequestToken" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Sidebar Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebar-overlay" onclick="closeSidebar()"></div>

    <!-- Shell Layout -->
    <div class="admin-shell">

        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar" id="sidebar">
            <div class="sidebar-logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span class="sidebar-logo-text">Veloria<span class="sidebar-logo-dot">.</span></span>
            </div>
            <ul class="sidebar-menu">
                <li>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-menu-item @(currentController == "Dashboard" ? "active" : "")">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="sidebar-menu-item @(currentController == "Products" ? "active" : "")">
                        <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                        Products
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="sidebar-menu-item @(currentController == "Categories" ? "active" : "")">
                        <svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                        Categories
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Brands" asp-action="Index" class="sidebar-menu-item @(currentController == "Brands" ? "active" : "")">
                        <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                        Brands
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="sidebar-menu-item @(currentController == "Orders" ? "active" : "")">
                        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        Orders
                    </a>
                </li>
                @* <li>
                    <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="sidebar-menu-item @(currentController == "Customers" ? "active" : "")">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        Customers
                    </a>
                </li> *@
               
            </ul>
            <div class="sidebar-footer">
                <div class="admin-profile-info">
                    <h4>@(User.Identity?.Name ?? "Adham Mohamed")</h4>
                    <p>Administrator</p>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="admin-main">

            <partial name="_TopHeader" />

            <!-- Page Container -->
            @RenderBody()

        </main>

    </div>

    @await RenderSectionAsync("Modals", required: false)

    <!-- JavaScript Bundle -->
    <script src="~/admin/js/admin-shell.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
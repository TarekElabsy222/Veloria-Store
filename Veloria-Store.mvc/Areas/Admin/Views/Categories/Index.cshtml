@using Veloria_Store.Application.ViewModels.CategoryViiewModels
@model IEnumerable<CategoryVM>

<div class="page-container">

    <!-- Header -->
    <div class="page-header">

        <div class="page-title">

            <h2>Product Categories</h2>

            <p>
                Manage categories layout and slugs structure for the public store catalog.
            </p>

        </div>

        <button class="btn btn-primary"
                onclick="openAddCategoryModal()">

            <svg width="18"
                 height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5">

                <line x1="12" y1="5" x2="12" y2="19"></line>

                <line x1="5" y1="12" x2="19" y2="12"></line>

            </svg>

            Add Category

        </button>

    </div>

    <!-- Search -->

    <div class="filters-bar">

        <div class="search-input-group">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor">

                <circle cx="11" cy="11" r="8"></circle>

                <line x1="21"
                      y1="21"
                      x2="16.65"
                      y2="16.65">
                </line>

            </svg>

            <input type="text"
                   id="category-search"
                   placeholder="Search category name...">

        </div>

    </div>

    <!-- Table -->

    <div class="data-card">

        <div class="table-responsive">

            <table class="data-table">

                <thead>

                    <tr>

                        <th>Image </th>


                        <th>Name</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody id="categories-table-body">
                </tbody>

            </table>

        </div>

    </div>

</div>






@section Modals{

<div class="modal-backdrop" id="category-modal">

    <div class="modal-content">

        <div class="modal-header">

            <h3 id="modal-title">
                Add Category
            </h3>

            <button type="button"
                    class="modal-close-btn"
                    onclick="closeCategoryModal()">

                ✕

            </button>

        </div>

            <form id="category-form">

            <input type="hidden" id="cat-id"/>

            <div class="modal-body">

                <div class="form-group">

                    <label class="form-label">
                        Category Name
                    </label>

                    <input type="text"
                           id="cat-name"
                           class="form-control"
                           required/>

                </div>

                    <div class="form-group">

                        <label class="form-label">
                            Category Image
                        </label>

                        <div class="image-upload-zone"
                             onclick="document.getElementById('cat-image').click()">

                            <svg viewBox="0 0 24 24"
                                 width="40"
                                 height="40"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <rect x="3"
                                      y="3"
                                      width="18"
                                      height="18"
                                      rx="2"></rect>

                                <circle cx="8.5"
                                        cy="8.5"
                                        r="1.5"></circle>

                                <polyline points="21 15 16 10 5 21"></polyline>

                            </svg>

                            <h4>Upload Category Image</h4>

                            <p>Click to choose an image</p>

                            <input type="file"
                                   id="cat-image"
                                   accept="image/*"
                                   hidden>

                        </div>

                        <div id="image-preview"
                             class="image-preview-container"></div>

                    </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline"
                        onclick="closeCategoryModal()">

                    Cancel

                </button>

                <button type="submit"
                        class="btn btn-primary">

                    Save Category

                </button>

            </div>

        </form>

    </div>

</div>

}



@section Scripts {

    <script src="~/admin/js/admin-categories.js"></script>

}
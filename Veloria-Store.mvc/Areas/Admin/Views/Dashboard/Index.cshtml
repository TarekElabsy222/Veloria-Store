@using Veloria_Store.Application.ViewModels.Dashboard
@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-container" id="dashboard-metrics-container">

    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title">
            <h2>Dashboard Overview</h2>
            <p>Welcome to your Voloria admin panel overview. Manage products, orders, categories, and customers.</p>
        </div>
    </div>

    <!-- Metrics Grid -->
    <div class="metrics-grid">
        <!-- Card 1 -->
        <div class="metric-card">
            <div class="metric-icon-box sales">
                <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="metric-info">
                <h3 id="metric-revenue">@Model.TotalRevenue.ToString("C")</h3>
                <p>Total Revenue</p>
            </div>
        </div>
        <!-- Card 2 -->
        <div class="metric-card">
            <div class="metric-icon-box orders">
                <svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            </div>
            <div class="metric-info">
                <h3 id="metric-orders">@Model.TotalOrders</h3>
                <p>Total Orders</p>
            </div>
        </div>
        <!-- Card 3 -->
        <div class="metric-card">
            <div class="metric-icon-box products">
                <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
            </div>
            <div class="metric-info">
                <h3 id="metric-products">@Model.TotalProducts</h3>
                <p>Total Products</p>
            </div>
        </div>
        <!-- Card 4 -->
        <div class="metric-card">
            <div class="metric-icon-box users">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            </div>
            <div class="metric-info">
                <h3 id="metric-users">@Model.TotalUsers</h3>
                <p>Registered Users</p>
            </div>
        </div>
    </div>

    <!-- Dashboard Widgets Main Grid -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px; align-items: start; margin-top: 10px;">

        <!-- Recent Orders Card -->
        <div class="data-card">
            <div class="card-header">
                <h3>Recent Orders</h3>
            </div>
            <div class="recent-orders-list" id="recent-orders-list">
                @foreach (var order in Model.RecentOrders)
                {
                    var statusClass = order.Status switch
                    {
                        "Pending" => "status-pending",
                        "Processing" => "status-processing",
                        "Shipped" => "status-shipped",
                        "Delivered" => "status-delivered",
                        "Cancelled" => "status-cancelled",
                        _ => "status-pending"
                    };

                    <div class="recent-order-item">

                        <div class="order-customer-info">

                            <div>

                                <strong style="font-size:0.9rem;color:var(--secondary-color);">
                                    @order.CustomerName
                                </strong>

                                <p style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;">
                                    @order.OrderNumber
                                </p>

                                <small style="color:var(--text-muted);">
                                    @order.CreatedAt.ToString("dd MMM yyyy")
                                </small>

                            </div>

                        </div>

                        <div style="display:flex;align-items:center;gap:18px;">

                            <strong style="font-size:0.9rem;color:var(--secondary-color);">
                                @order.Total.ToString("C")
                            </strong>

                            <span class="badge @statusClass">
                                @order.Status
                            </span>

                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                               class="order-detail-btn">
                                View
                            </a>

                        </div>

                    </div>
                }
            </div>
        </div>







        <!-- Sales Analytics Info Card -->
        <div class="data-card">
            <div class="card-header">
                <h3>Quick Statistics</h3>
            </div>
            <div style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
                <div style="background-color: var(--primary-light); color: var(--primary-color); padding: 15px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 2px;">Veloria Platinum Store</h4>
                        <p style="font-size: 0.75rem; color: var(--primary-color); opacity: 0.9;">Store status is active and operational</p>
                    </div>
                    <span style="font-size: 1.5rem;">🌟</span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 6px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                        <span style="color: var(--text-muted);">Active Promotions</span>
                        <span style="font-weight: 600; color: var(--secondary-color);">4 Active Coupons</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                        <span style="color: var(--text-muted);">Monthly Performance Goal</span>
                        <span style="font-weight: 600; color: var(--success);">88% Completed</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; padding-bottom: 8px;">
                        <span style="color: var(--text-muted);">Customer Satisfaction</span>
                        <span style="font-weight: 600; color: var(--secondary-color);">98.4% (4.9 / 5.0)</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
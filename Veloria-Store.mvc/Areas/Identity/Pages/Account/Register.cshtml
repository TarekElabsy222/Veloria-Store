@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<main class="main">
    <!--=============== BREADCRUMB ===============-->
    <section class="breadcrumb">
        <ul class="breadcrumb__list flex container">
            <li><a href="index.html" class="breadcrumb__link">Home</a></li>
            <li><span class="breadcrumb__link">></span></li>
            <li><span class="breadcrumb__link">Login / Register</span></li>
        </ul>
    </section>

    <!--=============== LOGIN-REGISTER ===============-->
    <section class="login-register section--lg">
        <div class="login-register__container container grid">
          
            <div class="register">
                <h3 class="section__title">Create an Account</h3>
                <form class="form grid" id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                    <input asp-for="Input.Email" class="form__input" autocomplete="username" aria-required="true" placeholder="Your Email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>

                    <input asp-for="Input.Password" class="form__input" autocomplete="new-password" aria-required="true" placeholder="Your Password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>

                    <input asp-for="Input.ConfirmPassword" class="form__input" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>


                    <div class="form__btn">
                        <button id="registerSubmit" type="submit" class="btn">Submit & Register</button>
                    </div>
                </form>
            </div>
        </div>
    </section>

</main>





@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
